{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CozyVerse Asset",
  "type": "object",
  "required": [
    "asset_id",
    "name",
    "category",
    "count",
    "source_visibility",
    "confidence",
    "visible_features",
    "inferred_features",
    "views",
    "qa"
  ],
  "properties": {
    "asset_id": {
      "type": "string",
      "pattern": "^[A-Z]{2,5}-[0-9]{3,5}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string"
    },
    "parent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "scene_zone": {
      "type": "string"
    },
    "bbox_normalized_xywh": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "minItems": 4,
      "maxItems": 4
    },
    "source_visibility": {
      "enum": [
        "fully_visible",
        "partially_visible",
        "front_and_partial_side",
        "mostly_occluded",
        "unseen_inferred"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "visible_features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inferred_features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approximate_relative_scale": {
      "type": "string"
    },
    "palette": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "style_notes": {
      "type": "string"
    },
    "instances": {
      "type": "array"
    },
    "geometry_consistency_notes": {
      "type": "string"
    },
    "mesh": {
      "type": "object"
    },
    "views": {
      "type": "object",
      "required": [
        "front",
        "back",
        "left",
        "right",
        "perspective"
      ],
      "properties": {
        "front": {
          "type": "object",
          "required": [
            "path",
            "status",
            "camera_type",
            "inferred_regions"
          ],
          "properties": {
            "path": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "enum": [
                "BLOCKED",
                "DRAFT",
                "NEEDS_REVIEW",
                "PASSED",
                "FAILED"
              ]
            },
            "camera_type": {
              "const": "ORTHO"
            },
            "inferred_regions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "back": {
          "type": "object",
          "required": [
            "path",
            "status",
            "camera_type",
            "inferred_regions"
          ],
          "properties": {
            "path": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "enum": [
                "BLOCKED",
                "DRAFT",
                "NEEDS_REVIEW",
                "PASSED",
                "FAILED"
              ]
            },
            "camera_type": {
              "const": "ORTHO"
            },
            "inferred_regions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "left": {
          "type": "object",
          "required": [
            "path",
            "status",
            "camera_type",
            "inferred_regions"
          ],
          "properties": {
            "path": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "enum": [
                "BLOCKED",
                "DRAFT",
                "NEEDS_REVIEW",
                "PASSED",
                "FAILED"
              ]
            },
            "camera_type": {
              "const": "ORTHO"
            },
            "inferred_regions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "right": {
          "type": "object",
          "required": [
            "path",
            "status",
            "camera_type",
            "inferred_regions"
          ],
          "properties": {
            "path": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "enum": [
                "BLOCKED",
                "DRAFT",
                "NEEDS_REVIEW",
                "PASSED",
                "FAILED"
              ]
            },
            "camera_type": {
              "const": "ORTHO"
            },
            "inferred_regions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "perspective": {
          "type": "object",
          "required": [
            "path",
            "status",
            "camera_type",
            "inferred_regions"
          ],
          "properties": {
            "path": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "enum": [
                "BLOCKED",
                "DRAFT",
                "NEEDS_REVIEW",
                "PASSED",
                "FAILED"
              ]
            },
            "camera_type": {
              "const": "PERSP"
            },
            "inferred_regions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "additionalProperties": true
    },
    "qa": {
      "type": "object",
      "required": [
        "status",
        "issues"
      ],
      "properties": {
        "status": {
          "enum": [
            "BLOCKED",
            "DRAFT",
            "NEEDS_REVIEW",
            "PASSED",
            "FAILED"
          ]
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "modeling_notes": {
      "type": "string"
    },
    "base_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Independent master diorama base ID, not embedded in building by default"
    },
    "default_base_policy": {
      "enum": [
        "none",
        "building_foundation",
        "local_plinth",
        "scene_context",
        "full_master_base"
      ]
    },
    "model_revision": {
      "type": "string"
    },
    "artifact_qa": {
      "type": "object",
      "additionalProperties": true
    }
  }
}

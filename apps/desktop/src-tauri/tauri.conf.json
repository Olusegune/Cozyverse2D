{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CozyVerse Breakdown",
  "version": "0.1.0",
  "identifier": "com.cozyverse.breakdown",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CozyVerse Breakdown",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "backgroundColor": "#0A1019"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:* ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser" } },
    "fileAssociations": [
      {
        "ext": ["cvbd"],
        "name": "CozyVerse Breakdown Project",
        "description": "CozyVerse Breakdown project",
        "role": "Editor"
      }
    ]
  }
}
